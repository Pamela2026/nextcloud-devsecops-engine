INTERNAL_NETWORK_NAME=hng-internal

NGINX_LOG_VOLUME_NAME=HNG-nginx-logs

NEXTCLOUD_IMAGE=kefaslungu/hng-nextcloud
NEXTCLOUD_CONTAINER_NAME=nextcloud
NEXTCLOUD_RESTART_POLICY=always
NEXTCLOUD_NGINX_LOG_PATH=/var/log/nginx
NEXTCLOUD_CPU_LIMIT=1.00
NEXTCLOUD_MEMORY_LIMIT=1024m
NEXTCLOUD_HEALTHCHECK_CMD=wget -q --spider http://127.0.0.1:80/status.php || wget -q --spider http://127.0.0.1:80/
NEXTCLOUD_HEALTHCHECK_INTERVAL=15s
NEXTCLOUD_HEALTHCHECK_TIMEOUT=5s
NEXTCLOUD_HEALTHCHECK_RETRIES=10
NEXTCLOUD_HEALTHCHECK_START_PERIOD=30s

NGINX_IMAGE=nginx:latest
NGINX_CONTAINER_NAME=hng-nginx
NGINX_RESTART_POLICY=always
NGINX_HOST_PORT=80
NGINX_CONTAINER_PORT=80
NGINX_CONFIG_SOURCE=./nginx/nginx.conf
NGINX_CONFIG_TARGET=/etc/nginx/nginx.conf 
NGINX_LOG_PATH=/var/log/nginx
NGINX_CPU_LIMIT=0.50
NGINX_MEMORY_LIMIT=256m
NGINX_HEALTHCHECK_CMD=nginx -t && wget -q --spider http://127.0.0.1:80/
NGINX_HEALTHCHECK_INTERVAL=15s
NGINX_HEALTHCHECK_TIMEOUT=5s
NGINX_HEALTHCHECK_RETRIES=5
NGINX_HEALTHCHECK_START_PERIOD=10s

DETECTOR_BUILD_CONTEXT=./detector
DETECTOR_CONTAINER_NAME=anomaly-detector
DETECTOR_RESTART_POLICY=always
DETECTOR_PRIVILEGED=true
DETECTOR_LOG_PATH=/logs
DETECTOR_COMMAND=python -u main.py
DETECTOR_CPU_LIMIT=0.50
DETECTOR_MEMORY_LIMIT=512m
DETECTOR_HEALTHCHECK_CMD=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/metrics', timeout=3).read()"
DETECTOR_HEALTHCHECK_INTERVAL=15s
DETECTOR_HEALTHCHECK_TIMEOUT=5s
DETECTOR_HEALTHCHECK_RETRIES=5
DETECTOR_HEALTHCHECK_START_PERIOD=30s
